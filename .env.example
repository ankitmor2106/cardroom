# Cardroom Environment Configuration

# Production or development
NODE_ENV=production

# Server listening port (default: 4000)
PORT=4000

# Web Origin for CORS / WebSocket checks.
# Set to "*" for same-origin single-container setups, or your custom domain (e.g., https://cardroom.example.com)
WEB_ORIGIN=*

# Required in production: At least 32 characters, high-entropy random string.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=e7b4c91a3f62850d9e84b2c17654a93f120893746c5b8e901f2a3b4c5d6e7f80

# Database URL:
# 1. To run in SQLite mode (single local file, no database server required):
DATABASE_URL=file:./data/cardroom.db

# 2. To run 100% in-memory (no database at all):
# Comment out or leave DATABASE_URL blank!
# DATABASE_URL=
