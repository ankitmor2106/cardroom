generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id          String           @id @default(uuid())
  displayName String
  avatar      String           @default("avatar-01")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  guest       GuestSession?
  memberships RoomPlayer[]
  results     GameResult[]
  settings    UserSetting?
  hostedRooms Room[]          @relation("RoomHost")
  gameEvents  GameEvent[]     @relation("GameEventActor")
}

model GuestSession {
  id        String   @id @default(uuid())
  playerId  String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Room {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  gameId      String
  visibility  String
  status      String       @default("waiting")
  hostId      String
  maxPlayers  Int
  passwordHash String?
  stateJson   Json?
  settingsJson Json?
  seq         Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  host        Player       @relation("RoomHost", fields: [hostId], references: [id], onDelete: Restrict)
  players     RoomPlayer[]
  events      GameEvent[]
  results     GameResult[]
  @@index([status, createdAt])
  @@index([gameId, status])
}

model RoomPlayer {
  id          String   @id @default(uuid())
  roomId      String
  playerId    String
  isHost      Boolean  @default(false)
  ready       Boolean  @default(false)
  connection  String   @default("disconnected")
  rejoinHash  String?
  joinedAt    DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([roomId, playerId])
  @@index([playerId, joinedAt])
}

model GameEvent {
  id        String   @id @default(uuid())
  roomId    String
  seq       Int
  actorId   String
  type      String
  payload   Json
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     Player   @relation("GameEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([roomId, seq])
}

model GameResult {
  id          String   @id @default(uuid())
  roomId      String
  playerId    String
  gameId      String
  placement   Int?
  score       Int      @default(0)
  won         Boolean  @default(false)
  summary     Json?
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([playerId, createdAt])
  @@index([gameId, createdAt])
}

model UserSetting {
  id          String   @id @default(uuid())
  playerId    String   @unique
  settings    Json
  updatedAt   DateTime @updatedAt
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
